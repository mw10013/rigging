{
  "name": "fixture-local",
  "version": "0.0.0",
  "private": true,
  "description": "A local app with no cloud that runs rigging's test presets: unit, browser and e2e",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "vp test run",
    "e2e:start": "rigging server start e2e -- env -u FORCE_COLOR NO_COLOR=1 vp dev --clearScreen false",
    "e2e:stop": "rigging server stop e2e",
    "test:e2e": "vp run e2e:start && playwright test"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@mw10013/rigging": "link:../../src",
    "@vitest/browser-playwright": "catalog:",
    "effect": "4.1.2",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
