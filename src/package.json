{
  "name": "@mw10013/rigging",
  "version": "0.0.0-source",
  "private": true,
  "description": "House toolkit for Effect, TypeScript and Vite+ projects: core plus an optional Cloudflare layer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mw10013/rigging.git"
  },
  "bin": {
    "rigging": "./bin/rigging.ts"
  },
  "type": "module",
  "imports": {
    "#rigging/*": "./*"
  },
  "exports": {
    "./core/app": "./core/app.ts",
    "./core/command": "./core/command.ts",
    "./core/test": "./core/test.ts",
    "./core/browser-test": "./core/browser-test.ts",
    "./core/test-runs": "./core/test-runs.ts",
    "./core/server-endpoint": "./core/server-endpoint.ts",
    "./core/lint/rules": "./core/lint/rules.ts",
    "./core/lint/conventions": "./core/lint/conventions.ts",
    "./cloudflare/stage": "./cloudflare/stage.ts",
    "./cloudflare/deployed-stack": "./cloudflare/deployed-stack.ts",
    "./cloudflare/test": "./cloudflare/test.ts",
    "./cloudflare/integ-setup": "./cloudflare/integ-setup.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-node": "^4.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.0.5",
    "vite": "*",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "//": "rigging's one manifest. `exports` and `bin` are the public surface, and the build makes one entry for each. A module not listed is internal: it builds as a chunk without a .d.mts, and importing it from outside fails. The built manifest maps each export to {types, default} in dist/ (scripts/build.ts)."
}
